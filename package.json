{
  "name": "@hyas/doks",
  "description": "Doks theme",
  "version": "0.4.3",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "defaults"
  ],
  "repository": "https://github.com/h-enk/doks",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "init": "shx rm -rf .git && git init -b main",
    "create": "hugo new",
    "prestart": "npm run clean",
    "start": "hugo server --bind=0.0.0.0 --disableFastRender --renderToMemory",
    "prebuild": "npm run clean",
    "build": "hugo --gc --minify",
    "build:preview": "npm run build -D -F",
    "clean": "shx rm -rf public resources",
    "clean:install": "shx rm -rf package-lock.json node_modules ",
    "lint": "npm run -s lint:scripts && npm run -s lint:styles && npm run -s lint:markdown",
    "lint:scripts": "eslint assets/js config functions",
    "lint:styles": "stylelint \"assets/scss/**/*.{css,sass,scss,sss,less}\"",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"content/**/*.md\"",
    "lint:markdown-fix": "markdownlint-cli2-fix \"*.md\" \"content/**/*.md\"",
    "server": "hugo server",
    "test": "npm run -s lint",
    "env": "env",
    "precheck": "npm version",
    "check": "hugo version",
    "copy:katex-fonts": "shx cp ./node_modules/katex/dist/fonts/* ./static/fonts/",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@babel/cli": "^7.17",
    "@babel/core": "^7.17",
    "@babel/preset-env": "^7.17",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@fullhuman/postcss-purgecss": "^6.0",
    "auto-changelog": "^2.4",
    "autoprefixer": "^10.4",
    "bootstrap": "^5.1",
    "clipboard": "^2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "flexsearch": "^0.7.21",
    "highlight.js": "^11.5",
    "hugo-extended": "0.155.3",
    "instant.page": "^5.1",
    "katex": "^0.16",
    "lazysizes": "^5.3",
    "markdownlint-cli2": "^0.23.3",
    "netlify-plugin-submit-sitemap": "^0.4.0",
    "node-fetch": "^3.2",
    "postcss": "^8.4",
    "postcss-cli": "^10.0.0",
    "purgecss-whitelister": "^2.4",
    "shx": "^0.3.4",
    "stylelint": "^17.15",
    "stylelint-config-standard-scss": "^6.1"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "js-yaml@4": "^4.3.2"
  }
}
